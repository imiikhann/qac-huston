# QAC Houston - Environment Variables
# Copy this file to .env.local and adjust values for your environment.
# API Base URL - change this to your production URL when deploying
NEXT_PUBLIC_API_URL=https://qachouston.com/api/v1
NEXT_PUBLIC_SITE_URL=https://qachouston.com
NEXT_PUBLIC_SITE_NAME=Quality Automotive Center - QAC Houston

# Real-time chat
# Live (shared cPanel): NEXT_PUBLIC_BROADCAST_DRIVER=pusher + Pusher keys
# Local/VPS Reverb:     NEXT_PUBLIC_BROADCAST_DRIVER=reverb + wss:// + port 443 behind TLS proxy
NEXT_PUBLIC_BROADCAST_DRIVER=reverb

NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1

NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=qachouston.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
